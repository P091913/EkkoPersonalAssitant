{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://localhost:5070",
  "Actions": {
    "discord_mute": { "Keys": "pageup" },
    "discord_deafen": { "Keys": "pagedown" },
    "volume_up": { "Keys": "volume_up", "Repeat": 3 },
    "volume_down": { "Keys": "volume_down", "Repeat": 3 },
    "play_pause": { "Keys": "play_pause" },
    "lock_pc": { "Lock": true },
    "steam": { "Launch": "%ProgramFiles(x86)%\\Steam\\steam.exe" }
  }
}

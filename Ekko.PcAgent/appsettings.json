{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://localhost:5070",
  "Actions": {
    "discord_mute": { "Keys": "pageup" },
    "discord_deafen": { "Keys": "pagedown" },
    "volume_up": { "Keys": "volume_up", "Repeat": 3 },
    "volume_down": { "Keys": "volume_down", "Repeat": 3 },
    "volume_mute": { "Keys": "volume_mute" },
    "play_pause": { "Keys": "play_pause" },
    "next_track": { "Keys": "next" },
    "previous_track": { "Keys": "previous" },
    "lock_pc": { "Lock": true },
    "task_manager": { "Keys": "ctrl+shift+esc" },
    "snip": { "Keys": "win+shift+s" },
    "show_desktop": { "Keys": "win+d" },
    "task_view": { "Keys": "win+tab" },
    "clipboard": { "Keys": "win+v" },
    "emoji": { "Keys": "win+." },
    "windows_settings": { "Keys": "win+i" },
    "minimize_all": { "Keys": "win+m" },
    "steam": { "Launch": "%ProgramFiles(x86)%\\Steam\\steam.exe" },
    "rustdesk": { "Launch": "%LOCALAPPDATA%\\rustdesk\\rustdesk.exe" }
  }
}

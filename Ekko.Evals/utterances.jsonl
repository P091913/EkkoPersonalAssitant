// One utterance per line: expected domain, and for built domains the expected tool and args.
// "none" = the domain is right but no tool does that. Args compare after Utterance.Simplify; schema defaults fill gaps.
// "args" may be a list when several answers behave identically (tvremote treats a season as implying series).
// Every real failure in the trace should become a line here.

// desktop - clean phrases (most hit the fast path)
{"text": "mute discord", "domain": "desktop", "tool": "discord_toggle_mute", "args": {}}
{"text": "volume up", "domain": "desktop", "tool": "adjust_volume", "args": {"direction": "up"}}
{"text": "open steam", "domain": "desktop", "tool": "open_app", "args": {"app": "steam"}}
{"text": "lock my computer", "domain": "desktop", "tool": "lock_pc", "args": {}}
{"text": "pause the music", "domain": "desktop", "tool": "media_play_pause", "args": {}}


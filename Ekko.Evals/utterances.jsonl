// desktop - asks for something no tool does: must be "none", not the closest tool
{"text": "close discord", "domain": "desktop", "tool": "none"}
{"text": "set the volume to 40 percent", "domain": "desktop", "tool": "none"}
{"text": "what window do I have open", "domain": "desktop", "tool": "none"}

// media - titles, including the spec's example
{"text": "play Scooby-Doo", "domain": "media", "tool": "play_media", "args": {"title": "Scooby-Doo"}}
{"text": "I'm really looking forward to Scooby-Doo right now", "domain": "media", "tool": "play_media", "args": {"title": "Scooby-Doo"}}
{"text": "I wanna watch Scooby-Doo", "domain": "media", "tool": "play_media", "args": {"title": "Scooby-Doo"}}
{"text": "put on the office", "domain": "media", "tool": "play_media", "args": {"title": "The Office"}}
{"text": "play season 2 episode 5 of the office", "domain": "media", "tool": "play_media", "args": [{"title": "The Office", "season": 2, "episode": 5}, {"title": "The Office", "kind": "series", "season": 2, "episode": 5}]}
{"text": "start season three of breaking bad", "domain": "media", "tool": "play_media", "args": [{"title": "Breaking Bad", "season": 3}, {"title": "Breaking Bad", "kind": "series", "season": 3}]}
{"text": "let's keep going with breaking bad", "domain": "media", "tool": "play_media", "args": {"title": "Breaking Bad"}}
{"text": "play the movie inception", "domain": "media", "tool": "play_media", "args": {"title": "Inception", "kind": "movie"}}
{"text": "put on the scooby doo show", "domain": "media", "tool": "play_media", "args": {"title": "Scooby-Doo", "kind": "series"}}
{"text": "honestly I could go for some spider-man tonight", "domain": "media", "tool": "play_media", "args": {"title": "Spider-Man"}}

// media - playback (bare words hit the fast path)
{"text": "pause", "domain": "media", "tool": "media_control", "args": {"action": "pause"}}
{"text": "stop the movie", "domain": "media", "tool": "media_control", "args": {"action": "stop"}}
{"text": "hold on, pause the show for a sec", "domain": "media", "tool": "media_control", "args": {"action": "pause"}}
{"text": "ok you can start the show back up", "domain": "media", "tool": "media_control", "args": {"action": "resume"}}

// budget - the expenses sheet. Item words like "bill" are dropped by the budget service, so both spellings behave the same.
{"text": "what bills do I still have to pay", "domain": "budget", "tool": "get_budget_status", "args": {}}
{"text": "how is the budget looking this month", "domain": "budget", "tool": "get_budget_status", "args": {}}
{"text": "how did october go money wise", "domain": "budget", "tool": "get_budget_status", "args": {"month": "october"}}
{"text": "how much do I have left for groceries", "domain": "budget", "tool": "get_budget_status", "args": {}}
{"text": "did my paycheck come in yet", "domain": "budget", "tool": "get_budget_status", "args": {}}
{"text": "I paid the water bill", "domain": "budget", "tool": "mark_bill_paid", "args": [{"item": "water"}, {"item": "water bill"}]}
{"text": "verizon is paid, it was 220", "domain": "budget", "tool": "mark_bill_paid", "args": {"item": "verizon", "amount": 220}}
{"text": "my paycheck came in", "domain": "budget", "tool": "mark_bill_paid", "args": {"item": "paycheck"}}
{"text": "ugh the car insurance finally went through, it was like 190", "domain": "budget", "tool": "mark_bill_paid", "args": {"item": "car insurance", "amount": 190}}
{"text": "unexpected expense, 380 for a new tire", "domain": "budget", "tool": "add_expense", "args": [{"item": "new tire", "amount": 380}, {"item": "tire", "amount": 380}]}
{"text": "I spent 12 bucks on lunch", "domain": "budget", "tool": "add_expense", "args": {"item": "lunch", "amount": 12}}
{"text": "I got 50 back from a refund", "domain": "budget", "tool": "add_expense", "args": {"item": "refund", "amount": 50, "income": true}}
{"text": "log 45.99 for the vet, that one was planned", "domain": "budget", "tool": "add_expense", "args": [{"item": "vet", "amount": 45.99, "planned": true}, {"item": "the vet", "amount": 45.99, "planned": true}]}
// budget - from the deck's trace (Nov 2), with made-up names and amounts. A row picked out by amount alone; "expense"
// names no row, so the budget service looks up by amount either way (DR-32).
{"text": "can you mark an expense off my spreadsheet? $12.47", "domain": "budget", "tool": "mark_bill_paid", "args": [{"amount": 12.47}, {"item": "expense", "amount": 12.47}]}
{"text": "check off the 12.47 one", "domain": "budget", "tool": "mark_bill_paid", "args": {"amount": 12.47}}
{"text": "mark netflix as paid", "domain": "budget", "tool": "mark_bill_paid", "args": {"item": "netflix"}}

// food - foods as words, the measure inside the food (DR-35). A plural and its singular are one food to the food service
// (FoodWords.Key), so both spellings behave the same. A question about a food isn't a log: chat can answer it.
{"text": "log two eggs and toast for breakfast", "domain": "food", "tool": "log_food", "args": [{"items": [{"food": "egg", "quantity": 2}, {"food": "toast"}]}, {"items": [{"food": "eggs", "quantity": 2}, {"food": "toast"}]}]}
{"text": "I just had a big mac", "domain": "food", "tool": "log_food", "args": {"items": [{"food": "big mac"}]}}
{"text": "had a burrito for lunch", "domain": "food", "tool": "log_food", "args": {"items": [{"food": "burrito"}]}}
{"text": "I ate 200 grams of chicken", "domain": "food", "tool": "log_food", "args": [{"items": [{"food": "gram of chicken", "quantity": 200}]}, {"items": [{"food": "grams of chicken", "quantity": 200}]}]}
{"text": "had two slices of pepperoni pizza", "domain": "food", "tool": "log_food", "args": [{"items": [{"food": "slice of pepperoni pizza", "quantity": 2}]}, {"items": [{"food": "slices of pepperoni pizza", "quantity": 2}]}]}
// "half a" left in the food is moved to the quantity by log_food (LogFood.Entry), so these behave the same.
{"text": "I had half a turkey sandwich", "domain": "food", "tool": "log_food", "args": [{"items": [{"food": "turkey sandwich", "quantity": 0.5}]}, {"items": [{"food": "half a turkey sandwich", "quantity": 0.5}]}, {"items": [{"food": "half a turkey sandwich"}]}]}
{"text": "I had a 300 calorie protein bar", "domain": "food", "tool": "log_food", "args": {"items": [{"food": "protein bar", "calories": 300}]}}
{"text": "how many calories have I had today", "domain": "food", "tool": "get_food_log", "args": {}}
{"text": "what did I eat yesterday", "domain": "food", "tool": "get_food_log", "args": {"day": "yesterday"}}
{"text": "I didn't actually eat the donut, take it off", "domain": "food", "tool": "undo_food", "args": {}}
{"text": "change my protein shake to 250 calories", "domain": "food", "tool": "set_food_calories", "args": {"food": "protein shake", "calories": 250}}
{"text": "how many calories are in a banana", "domain": "chat"}

// follow-ups: "before" holds the earlier turns of the session (DR-33). Shaped on the deck's Nov 2 trace, made-up values.
{"text": "that one was expected actually", "before": [{"user": "I spent 38 on gas", "ekko": "Add gas, $38 spent, marked unexpected. Go ahead?"}], "domain": "budget", "tool": "add_expense", "args": {"item": "gas", "amount": 38, "planned": true}}
{"text": "mark the first one paid", "before": [{"user": "what bills do I still have", "ekko": "November: 3 bills left to pay, $82 in all: Water $58 on Nov 15, Streaming (Kids) $3.49 on Nov 22, Gym $20.51 on Nov 25. Ending balance $922."}], "domain": "budget", "tool": "mark_bill_paid", "args": {"item": "water"}}
{"text": "it's the 15.99 one", "before": [{"user": "mark netflix paid", "ekko": "I couldn't find an unchecked netflix on this month's or last month's tab."}], "domain": "budget", "tool": "mark_bill_paid", "args": {"amount": 15.99}}
{"text": "actually put it back up", "before": [{"user": "volume down", "ekko": "Volume down."}], "domain": "desktop", "tool": "adjust_volume", "args": {"direction": "up"}}
{"text": "can you fire up steam for me", "before": [{"user": "what bills do I still have", "ekko": "November: 2 bills left to pay, $78 in all: Water $58 on Nov 15, Phone $20 on Nov 20."}, {"user": "thanks", "ekko": "You're welcome."}], "domain": "desktop", "tool": "open_app", "args": {"app": "steam"}}
{"text": "another one", "before": [{"user": "tell me a joke", "ekko": "Why did the scarecrow win an award? Because he was outstanding in his field!"}], "domain": "chat"}
{"text": "what about its logs", "before": [{"user": "is jellyfin ok", "ekko": "Jellyfin is running and healthy, up 5 days with no restarts."}], "domain": "server_ops"}
{"text": "more like 560", "before": [{"user": "I had a big mac", "ekko": "New food: big mac at 590 calories each. Log big mac. Go ahead?"}], "domain": "food", "tool": "log_food", "args": {"items": [{"food": "big mac", "calories": 560}]}}
{"text": "undo that", "before": [{"user": "I had a donut", "ekko": "Logged donut: 250 calories. 1,200 calories today."}], "domain": "food", "tool": "undo_food", "args": {}}


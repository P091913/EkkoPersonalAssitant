// media - titles, including the spec's example
{"text": "play Scooby-Doo", "domain": "media", "tool": "play_media", "args": {"title": "Scooby-Doo"}}
{"text": "I'm really looking forward to Scooby-Doo right now", "domain": "media", "tool": "play_media", "args": {"title": "Scooby-Doo"}}

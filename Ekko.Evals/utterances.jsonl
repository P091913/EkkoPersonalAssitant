// budget - the expenses sheet. Item words like "bill" are dropped by the budget service, so both spellings behave the same.
{"text": "what bills do I still have to pay", "domain": "budget", "tool": "get_budget_status", "args": {}}
{"text": "how is the budget looking this month", "domain": "budget", "tool": "get_budget_status", "args": {}}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Conversation": {
    "PendingMinutes": 3,
    "SessionMinutes": 5,
    "DeepAfter": 6,
    "MaxTurns": 12,
    "MaxHistoryChars": 6000
  },
  "Trace": {
    "Path": "data/trace.jsonl"
  },
  "PcService": {
    "BaseUrl": "http://localhost:5070/",
    "TimeoutSeconds": 5,
    "Apps": {
      "steam": "steam"
    }
  },
  "TvRemote": {
    "BaseUrl": "http://localhost:5055/",
    "TimeoutSeconds": 120
  },
  "Budget": {
    "BaseUrl": "http://localhost:5080/",
    "TimeoutSeconds": 20
  },
  "Food": {
    "BaseUrl": "http://localhost:5085/",
    "TimeoutSeconds": 10
  },
  "ServerOps": {
    "DockerUrl": "http://docker-proxy:2375/",
    "Restartable": [ "jellyfin" ],
    "Roots": {
      "media": "/host/media"
    },
    "MaxSteps": 8,
    "RunTimeoutSeconds": 120,
    "ToolTimeoutSeconds": 30,
    "ApprovalHours": 12,
    "RunsPath": "data/runs"
  },
  "Llm": {
    "Clients": {
      "qwen": {
        "Kind": "OpenAi",
        "BaseUrl": "http://localhost:11434/v1/",
        "Model": "qwen3.5:9b",
        "TimeoutSeconds": 30,
        "Effort": "none"
      },
      "haiku": {
        "Kind": "Anthropic",
        "BaseUrl": "https://api.anthropic.com/v1/",
        "Model": "claude-haiku-5-5",
        "TimeoutSeconds": 30,
        "Effort": "low"
      },
      "sonnet": {
        "Kind": "Anthropic",
        "BaseUrl": "https://api.anthropic.com/v1/",
        "Model": "claude-sonnet-5-5",
        "TimeoutSeconds": 30,
        "Effort": "low"
      },
      "haiku-agent": {
        "Kind": "Anthropic",
        "BaseUrl": "https://api.anthropic.com/v1/",
        "Model": "claude-haiku-5-5",
        "TimeoutSeconds": 60,
        "Effort": "medium"
      },
      "sonnet-agent": {
        "Kind": "Anthropic",
        "BaseUrl": "https://api.anthropic.com/v1/",
        "Model": "claude-sonnet-5-5",
        "TimeoutSeconds": 90,
        "Effort": "medium"
      }
    },
    "Steps": {
      "route": { "Primary": "qwen", "Fallback": "haiku", "Deep": "haiku" },
      "extract": { "Primary": "qwen", "Fallback": "haiku", "Deep": "haiku" },
      "chat": { "Primary": "qwen", "Fallback": "haiku", "Deep": "haiku" },
      "estimate": { "Primary": "sonnet", "Fallback": "haiku" },
      "server_ops": { "Primary": "haiku-agent", "Fallback": "sonnet-agent" }
    }
  }
}
